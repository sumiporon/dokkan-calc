{
  "manifest_version": 3,
  "name": "Dokkan Phase 11 one-tap prototype",
  "version": "0.1.0",
  "description": "Owner-tap navigation and displayed-DOM intake prototype. No background source requests.",
  "permissions": ["storage"],
  "host_permissions": ["https://jpnja.dokkaninfo.com/events/challenge/*"],
  "background": { "scripts": ["background.js"] },
  "content_scripts": [{
    "matches": ["https://jpnja.dokkaninfo.com/events/challenge/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "browser_specific_settings": {
    "gecko": {
      "id": "phase11-one-tap-prototype@sumiporon.invalid",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    },
    "gecko_android": { "strict_min_version": "142.0" }
  }
}
