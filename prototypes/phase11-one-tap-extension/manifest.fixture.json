{
  "manifest_version": 3,
  "name": "Dokkan Phase 11 fixture gate",
  "version": "0.1.0",
  "description": "Self-authored three-stage Android gate. No live-source access.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://raw.githack.com/sumiporon/dokkan-calc/*/phase11-one-tap-fixture/*"
  ],
  "background": { "scripts": ["background.js"] },
  "content_scripts": [{
    "matches": [
      "http://127.0.0.1/*",
      "http://localhost/*",
      "https://raw.githack.com/sumiporon/dokkan-calc/*/phase11-one-tap-fixture/*"
    ],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "browser_specific_settings": {
    "gecko": {
      "id": "phase11-fixture-gate@sumiporon.invalid",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    },
    "gecko_android": { "strict_min_version": "142.0" }
  }
}
