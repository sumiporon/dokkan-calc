{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sumiporon.github.io/dokkan-calc/schemas/enemy-data-release-manifest-v1.schema.json",
  "title": "Dokkan Calc enemy-data release manifest v1",
  "type": "object", "additionalProperties": false,
  "required": ["manifestSchemaVersion", "manifestId", "datasetVersion", "generatedAt", "channel", "releaseState", "canonicalSchemaVersion", "runtimeSchemaVersion", "sourceSnapshots", "artifacts", "counts", "compatibleAppVersion", "previousKnownGood", "validation", "permission"],
  "properties": {
    "manifestSchemaVersion": { "const": "1.0.0" }, "manifestId": { "type": "string", "minLength": 1 }, "datasetVersion": { "type": "string", "minLength": 1 }, "generatedAt": { "type": "string", "format": "date-time" },
    "channel": { "enum": ["candidate", "stable"] }, "releaseState": { "enum": ["candidate", "stable", "known-good", "quarantined"] }, "canonicalSchemaVersion": { "const": "2.0.0" }, "runtimeSchemaVersion": { "const": "1.0.0" },
    "sourceSnapshots": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "sourceKey", "acquiredAt", "contentDigest", "policyStatus"], "properties": { "id": { "type": "string", "minLength": 1 }, "sourceKey": { "type": "string", "minLength": 1 }, "acquiredAt": { "type": "string", "format": "date-time" }, "contentDigest": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" }, "policyStatus": { "type": "string", "minLength": 1 } } } },
    "artifacts": { "type": "object", "additionalProperties": false, "required": ["sourceInput", "canonical", "runtime", "validationReport", "omissionReport"], "properties": { "sourceInput": { "$ref": "#/$defs/artifact" }, "canonical": { "$ref": "#/$defs/artifact" }, "runtime": { "$ref": "#/$defs/artifact" }, "validationReport": { "$ref": "#/$defs/artifact" }, "omissionReport": { "$ref": "#/$defs/artifact" } } },
    "counts": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "integer", "minimum": 0 } },
    "compatibleAppVersion": { "type": "object", "additionalProperties": false, "required": ["minimum", "maximum", "productionAppReadsArtifact"], "properties": { "minimum": { "type": "string", "minLength": 1 }, "maximum": { "type": ["string", "null"] }, "productionAppReadsArtifact": { "type": "boolean" } } },
    "previousKnownGood": { "type": "object", "additionalProperties": false, "required": ["datasetVersion", "artifactDigest", "manifestDigest", "kind"], "properties": { "datasetVersion": { "type": "string", "minLength": 1 }, "artifactDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "manifestDigest": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" }, "kind": { "enum": ["legacy-production", "phase6-release"] } } },
    "validation": { "type": "object", "additionalProperties": false, "required": ["status", "gateVersion", "hardFailCount", "reviewRequiredCount", "informationalCount", "reportDigest"], "properties": { "status": { "enum": ["passed", "review-required", "hard-fail"] }, "gateVersion": { "const": "1.0.0" }, "hardFailCount": { "type": "integer", "minimum": 0 }, "reviewRequiredCount": { "type": "integer", "minimum": 0 }, "informationalCount": { "type": "integer", "minimum": 0 }, "reportDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } } },
    "permission": { "type": "object", "additionalProperties": false, "required": ["ledgerDigest", "offlineTransformAllowed", "productionPublishAllowed"], "properties": { "ledgerDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "offlineTransformAllowed": { "type": "boolean" }, "productionPublishAllowed": { "type": "boolean" } } }
  },
  "$defs": { "artifact": { "type": "object", "additionalProperties": false, "required": ["path", "digest", "bytes", "schemaVersion"], "properties": { "path": { "type": "string", "minLength": 1 }, "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "bytes": { "type": "integer", "minimum": 1 }, "schemaVersion": { "type": "string", "minLength": 1 } } } }
}
