# Dependencies
/node_modules/
/scraper/node_modules/

# Local credentials and browser-profile data
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
/Cookies
/Cookies-journal
/Login Data
/Login Data-journal
/Local Storage/
/Session Storage/
/IndexedDB/

# Local safety archives and research material
/safety-backups/

# Runtime and browser-test output
/playwright-report/
/test-results/
*.log

# Reproducible, potentially large Phase 4 migration outputs. Keep the compact
# manifest, summary, and representative fixture tracked instead.
/generated/phase4/

# Reproducible full-size Phase 6 canonical/runtime outputs and compiled trial
# modules. Compact reports and representative fixtures stay tracked.
/generated/phase6/

# Reproducible Phase 7 full/chunk/file-compatible prototype outputs. Compact
# manifests, measurements, and representative fixtures stay tracked.
/generated/phase7/

# Reproducible Phase 8 full-size release-candidate output. The separately
# tracked public preview contains fictional fixtures only.
/generated/phase8/

# Phase 10 intake material is internal-only unless separate publication review
# approves it. The read-only review CLI never writes to this directory.
/generated/phase10/

# Scraper caches and intermediate data
# Some of these paths are already tracked in the legacy history. Ignoring them
# here does not delete or untrack those files; that decision is deferred.
/scraper/html_cache/
/scraper/.cache/
/scraper/all_enemies_backup.json
/scraper/all_enemies_progress.json

# Legacy one-off helper scripts and temporary output
# Existing files are preserved in the legacy baseline; newly-created scratch
# files should not be mixed into normal product commits.
/temp_*.txt
/temp_*.json
/simulate_calc.js
/check_manual_dmg2.js
/find_*.js
/inspect_*.js
/remove_*.js
/dedupe_*.js
/reorder_*.js
/patch_*.js
/fix_*.js
/fast_*.js
/delete_*.js
/stream_*.js
/check_*.js
/updateScenarioResults_dump.js
/extract_*.js
/console.log(f.filename
/testOut.txt
/test_replace.txt

# Legacy scraper experiments and their output
/scraper/test*.js
/scraper/testOutput*
